{
  "name": "xgp-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Multilingual Xbox Game Pass catalog browser with replaceable data providers",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "sync": "tsx scripts/sync-catalog.ts",
    "inspect": "tsx scripts/inspect-catalog.ts",
    "inspect:artifact": "tsx scripts/inspect-catalog.ts --artifact dist",
    "build": "astro build",
    "build:pages": "npm run check && npm run sync && npm run inspect && npm run build && npm run inspect:artifact",
    "preview": "astro preview",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-select": "^2.3.3",
    "astro": "^7.1.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
